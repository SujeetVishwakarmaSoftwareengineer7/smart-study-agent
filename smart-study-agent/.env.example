# Smart Study Generator — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ──────────────────────────────────────────────
# REQUIRED: Your Groq API key
# Get yours at: https://console.groq.com/keys
# ──────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────
# Flask secret key (change this to a random string)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# ──────────────────────────────────────────────
FLASK_SECRET_KEY=change-this-to-a-random-secret-key

# ──────────────────────────────────────────────
# Optional settings
# ──────────────────────────────────────────────
FLASK_ENV=development
MAX_FILE_SIZE_MB=10

# ──────────────────────────────────────────────
# Model — set to the exact slug from console.groq.com/docs/models
# Default used by the app: qwen/qwen3.8-27b (confirmed available on Groq)
# ──────────────────────────────────────────────
GROQ_MODEL=qwen/qwen3.8-27b
