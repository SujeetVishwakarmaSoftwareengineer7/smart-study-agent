# Smart Study Generator - .gitignore

# Environment / secrets - NEVER commit these
.env
*.env.local
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
venv/
.venv/
env/

# Uploads - user files, not source code
uploads/*
!uploads/.gitkeep

# Session / progress data - runtime data, not source code
data/*
!data/.gitkeep

# Logs
*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
